---
/**
 * Left sidebar with navigation links. Renders client-side: links go to
 * the appropriate Astro pages. The logout button revokes the HttpOnly
 * session cookie and reloads.
 */
import { sitePath } from '../lib/site-path';

interface Props {
  active?: 'dashboard' | 'positions' | 'analyses' | 'sessions' | 'agent' | 'observability' | 'documentation' | 'skills' | 'tools' | 'backtest' | 'backtest-cripto';
}

const { active } = Astro.props;

const links = [
  { key: 'dashboard', href: sitePath('/dashboard'), label: 'Control center', icon: '◉' },
  { key: 'positions', href: sitePath('/dashboard/positions'), label: 'Posiciones', icon: '📈' },
  { key: 'analyses', href: sitePath('/dashboard/analyses'), label: 'Análisis', icon: '🔬' },
  { key: 'sessions', href: sitePath('/dashboard/sessions'), label: 'Sesiones', icon: '⏱️' },
  { key: 'agent', href: sitePath('/dashboard/agent'), label: 'Agente', icon: '🤖' },
  { key: 'observability', href: sitePath('/dashboard/observability'), label: 'Observabilidad', icon: '📡' },
  { key: 'documentation', href: sitePath('/dashboard/documentation'), label: 'Docs Link', icon: '🔐' },
  { key: 'backtest', href: sitePath('/dashboard/backtest'), label: 'Backtest Bolsa', icon: '🧪' },
  { key: 'backtest-cripto', href: sitePath('/dashboard/backtest-cripto'), label: 'Backtest Cripto', icon: '🪙' },
  { key: 'skills', href: sitePath('/skills'), label: 'Skills', icon: '🧩' },
  { key: 'drafts', href: sitePath('/skills/drafts'), label: 'Borradores', icon: '📝' },
  { key: 'tools', href: sitePath('/tools'), label: 'Tools', icon: '🔧' },
] as const;
---
<aside class="relative lg:fixed left-0 top-0 min-h-0 lg:h-screen w-full lg:w-64 bg-gray-900 text-white flex flex-col z-30 dashboard-sidebar">
  <div class="px-6 py-5 border-b border-gray-800">
    <h1 class="text-xl font-bold tracking-tight">opes-quant</h1>
    <p class="text-xs text-gray-400 mt-1">Trading agent dashboard</p>
  </div>

  <nav class="flex-1 flex lg:block overflow-x-auto px-3 py-3 lg:py-4 space-x-1 lg:space-x-0 lg:space-y-1">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'flex shrink-0 items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors',
          active === link.key
            ? 'bg-brand-600 text-white font-semibold'
            : 'text-gray-300 hover:bg-gray-800 hover:text-white',
        ]}
      >
        <span class="text-base" aria-hidden="true">{link.icon}</span>
        <span>{link.label}</span>
      </a>
    ))}
  </nav>

  <div class="px-3 py-4 border-t border-gray-800">
    <button
      id="logout-btn"
      type="button"
      class="w-full flex items-center gap-3 px-3 py-2 rounded-md text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition-colors"
    >
      <span aria-hidden="true">🚪</span>
      <span>Salir</span>
    </button>
  </div>
</aside>

<script>
  import { api } from '../lib/api';
  import { sitePath } from '../lib/site-path';

  document.getElementById('logout-btn')?.addEventListener('click', () => {
    api.logout()
      .catch(() => undefined)
      .finally(() => {
        sessionStorage.removeItem('opes_auth');
        localStorage.removeItem('opes_auth');
        window.location.href = sitePath('/login');
      });
  });
</script>
