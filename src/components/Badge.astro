---
/**
 * Small status badge (Pill). Useful for status enums like 'open'/'closed'/'success'/'failed'.
 */
interface Props {
  text: string;
  variant?: 'default' | 'success' | 'danger' | 'warning' | 'info';
}

const { text, variant = 'default' } = Astro.props;

const styles: Record<NonNullable<Props['variant']>, string> = {
  default: 'bg-gray-100 text-gray-700',
  success: 'bg-green-100 text-green-800',
  danger: 'bg-red-100 text-red-800',
  warning: 'bg-yellow-100 text-yellow-800',
  info: 'bg-blue-100 text-blue-800',
};
---
<span class:list={['inline-block px-2 py-0.5 rounded-full text-xs font-medium', styles[variant]]}>
  {text}
</span>
