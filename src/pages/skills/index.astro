---
/**
 * /skills — list of skills on the server (read-only).
 */
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Skills" active="skills">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Skills del server</h2>
      <p class="text-sm text-muted mt-1">Lista de skills cargadas por Hermes.</p>
    </div>
    <div class="text-xs text-muted">
      <span class="px-2 py-0.5 bg-yellow-100 text-yellow-800 rounded-full">Read-only</span>
      Editor en Fase 4
    </div>
  </div>

  <div id="skills-root" data-testid="skills-list">
    <div class="card text-sm text-muted">Cargando skills…</div>
  </div>

  <script>
    import { api } from '../../lib/api';

    async function load() {
      const root = document.getElementById('skills-root');
      if (!root) return;
      try {
        const skills = await api.skills();
        if (skills.length === 0) {
          root.innerHTML = '<div class="card text-sm text-muted">Sin skills registradas.</div>';
          return;
        }
        root.innerHTML = `
          <div class="card p-0">
            <ul class="divide-y divide-gray-100">
              ${skills.map(s => {
                const version = s.frontmatter?.version ?? '—';
                const description = s.frontmatter?.description ?? '(sin descripción)';
                return `
                  <li class="px-6 py-4 flex items-center justify-between">
                    <div>
                      <a href="/skills/${s.name}" class="font-mono text-sm font-semibold text-brand-600 hover:text-brand-700">${s.name}</a>
                      <p class="text-xs text-muted mt-1 line-clamp-1">${description}</p>
                    </div>
                    <span class="text-xs font-mono text-muted">v${version}</span>
                  </li>
                `;
              }).join('')}
            </ul>
          </div>
        `;
      } catch (e) {
        root.innerHTML = `<div class="card text-sm text-loss">Error: ${(e as Error).message}</div>`;
      }
    }
    load();
  </script>
</Layout>
