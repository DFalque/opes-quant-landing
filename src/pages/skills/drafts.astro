---
/**
 * /skills/drafts — list of all skill drafts (across all skills), with
 * status and links. Admin/editor only.
 */
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Borradores" active="skills">
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900">Borradores de skills</h2>
    <p class="text-sm text-muted mt-1">
      Borradores pendientes de publicar. Los admins pueden publicarlos desde la página de cada skill.
    </p>
  </div>

  <div id="drafts-root" data-testid="drafts-list">
    <div class="card text-sm text-muted">Cargando borradores…</div>
  </div>

  <script>
    import { api } from '../../lib/api';
    import { formatDateTime } from '../../lib/format';

    async function load() {
      const root = document.getElementById('drafts-root');
      if (!root) return;
      try {
        const drafts = await api.drafts();
        if (drafts.length === 0) {
          root.innerHTML = '<div class="card text-sm text-muted">Sin borradores. Crea uno desde la página de una skill.</div>';
          return;
        }
        const variant = (status: string) => {
          if (status === 'published') return 'success';
          if (status === 'failed') return 'danger';
          if (status === 'publishing') return 'info';
          return 'warning'; // draft
        };
        root.innerHTML = `
          <div class="card p-0">
            <table class="min-w-full divide-y divide-gray-200 text-sm">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Skill</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Bump</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Status</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Updated</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Commit</th>
                  <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Acción</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                ${drafts.map(d => `
                  <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 font-mono">
                      <a href="/skills/${d.skill_name}/edit" class="text-brand-600 hover:text-brand-700">${d.skill_name}</a>
                    </td>
                    <td class="px-4 py-3">${d.bump_type}</td>
                    <td class="px-4 py-3">
                      <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium ${
                        d.status === 'published' ? 'bg-green-100 text-green-800'
                        : d.status === 'failed' ? 'bg-red-100 text-red-800'
                        : d.status === 'publishing' ? 'bg-blue-100 text-blue-800'
                        : 'bg-yellow-100 text-yellow-800'
                      }">${d.status}</span>
                    </td>
                    <td class="px-4 py-3">${formatDateTime(d.updated_at)}</td>
                    <td class="px-4 py-3 font-mono text-xs text-muted">${d.commit_sha ? d.commit_sha.slice(0, 7) : '—'}</td>
                    <td class="px-4 py-3 text-right">
                      <a href="/skills/${d.skill_name}/edit" class="text-brand-600 hover:text-brand-700 text-xs">Editar →</a>
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        `;
      } catch (e) {
        root.innerHTML = `<div class="card text-sm text-loss">Error: ${(e as Error).message}</div>`;
      }
    }
    load();
  </script>
</Layout>
