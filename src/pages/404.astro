---
/**
 * GitHub Pages fallback. When a user hits an unknown URL, redirect to the
 * landing page under the repository base path.
 * This is the standard workaround for client-side routing on GitHub Pages.
 *
 * The base path is injected at build time so project Pages URLs keep working.
 */
const basePath = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${basePath}`} />
    <title>OPES — Intelligence for markets</title>
  </head>
  <body>
    <p>Redirigiendo a <a href={basePath}>{basePath}</a>…</p>
    <script define:vars={{ basePath }}>window.location.replace(basePath);</script>
  </body>
</html>
