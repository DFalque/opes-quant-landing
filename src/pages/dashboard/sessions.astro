---
/**
 * /dashboard/sessions — timeline of agent sessions.
 * v1.2.0: includes duration, tokens, cost, errors, warnings, subagent_calls
 * columns from `metricas.json` heuristic-v1 (see ADR-0009).
 */
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Sesiones" active="sessions">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Sesiones del agente</h2>
      <p class="text-sm text-muted mt-1">
        Historial de invocaciones del orquestador y sub-agentes.
        <span class="text-xs text-muted-foreground">
          Telemetría: <code class="font-mono">heuristic-v1</code> (estimación chars/4; refinar cuando opencode-go exponga usage).
        </span>
      </p>
    </div>
  </div>

  <div id="sessions-root" data-testid="sessions-list">
    <div class="card text-sm text-muted">Cargando sesiones…</div>
  </div>

  <script>
    import { api } from '../../lib/api';
    import { formatDateTime, formatDuration, formatTokens, formatCostUsd } from '../../lib/format';

    const statusVariant: Record<string, string> = {
      success: 'bg-green-100 text-green-800',
      failed: 'bg-red-100 text-red-800',
      running: 'bg-blue-100 text-blue-800',
      aborted: 'bg-yellow-100 text-yellow-800',
    };

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderSession(s: any): string {
      const subagents = s.subagent_calls ?? 0;
      const errs = s.errors_count ?? 0;
      const warns = s.warnings_count ?? 0;
      const hasTelemetry = s.metric_source != null;
      return `
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3">
            <a href="/dashboard/sessions/${encodeURIComponent(s.session_key)}" class="font-mono text-sm font-semibold text-brand-600 hover:underline">${escapeHtml(s.session_key)}</a>
            <div class="text-xs text-muted mt-0.5">
              ${escapeHtml(s.agent_type ?? 'orchestrator')} · ${escapeHtml(s.model ?? 'unknown')}
              ${s.trigger ? `· <span class="text-gray-500">${escapeHtml(s.trigger)}</span>` : ''}
            </div>
          </td>
          <td class="px-4 py-3 text-xs text-muted whitespace-nowrap" data-testid="session-started">
            ${formatDateTime(s.started_at)}
            ${s.ended_at ? `<div class="text-gray-400">→ ${formatDateTime(s.ended_at)}</div>` : ''}
          </td>
          <td class="px-4 py-3 text-sm text-right tabular-nums" data-testid="session-duration">
            ${formatDuration(s.duration_seconds)}
          </td>
          <td class="px-4 py-3 text-sm text-right tabular-nums text-muted" data-testid="session-tokens"
              title="${hasTelemetry ? 'Estimación chars/4 (heuristic-v1)' : 'Sin telemetría'}">
            ${s.input_tokens || s.output_tokens
              ? `<span class="text-gray-900">${formatTokens(s.input_tokens)}</span> <span class="text-gray-400">/</span> <span class="text-gray-700">${formatTokens(s.output_tokens)}</span>`
              : '—'}
          </td>
          <td class="px-4 py-3 text-sm text-right tabular-nums" data-testid="session-cost">
            ${formatCostUsd(s.cost_usd)}
          </td>
          <td class="px-4 py-3 text-center">
            ${subagents > 0
              ? `<span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700" title="Sub-agentes invocados">${subagents}</span>`
              : '<span class="text-muted text-xs">—</span>'}
          </td>
          <td class="px-4 py-3 text-center">
            ${errs > 0
              ? `<span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800" title="${errs} error(es)">${errs}</span>`
              : '<span class="text-muted text-xs">0</span>'}
          </td>
          <td class="px-4 py-3 text-center">
            ${warns > 0
              ? `<span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800" title="${warns} warning(s)">${warns}</span>`
              : '<span class="text-muted text-xs">0</span>'}
          </td>
          <td class="px-4 py-3 text-center">
            <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium ${
              statusVariant[s.status] ?? 'bg-gray-100 text-gray-800'
            }" data-testid="session-status">${escapeHtml(s.status)}</span>
          </td>
        </tr>
      `;
    }

    async function load() {
      const root = document.getElementById('sessions-root');
      if (!root) return;
      try {
        const sessions = await api.agentSessions({ limit: 50 });
        if (sessions.length === 0) {
          root.innerHTML = '<div class="card text-sm text-muted">Sin sesiones registradas.</div>';
          return;
        }
        root.innerHTML = `
          <div class="card p-0 overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200" data-testid="sessions-table">
              <thead class="bg-gray-50">
                <tr class="text-xs uppercase tracking-wider text-muted text-left">
                  <th class="px-4 py-3 font-semibold">Sesión</th>
                  <th class="px-4 py-3 font-semibold">Inicio → Fin</th>
                  <th class="px-4 py-3 font-semibold text-right">Duración</th>
                  <th class="px-4 py-3 font-semibold text-right" title="Input / Output tokens (estimados)">Tokens in / out</th>
                  <th class="px-4 py-3 font-semibold text-right">Coste</th>
                  <th class="px-4 py-3 font-semibold text-center" title="Sub-agentes invocados">Subs</th>
                  <th class="px-4 py-3 font-semibold text-center" title="Errores detectados">Err</th>
                  <th class="px-4 py-3 font-semibold text-center" title="Warnings detectados">Warn</th>
                  <th class="px-4 py-3 font-semibold text-center">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 bg-white">
                ${sessions.map(renderSession).join('')}
              </tbody>
            </table>
          </div>
          <div class="text-xs text-muted mt-3" data-testid="sessions-count">
            ${sessions.length} sesiones (mostradas). Para vista agregada con KPIs y gráficos, ver
            <a href="/dashboard/observability" class="text-brand-600 hover:underline">Observabilidad</a>.
          </div>
        `;
      } catch (e) {
        root.innerHTML = `<div class="card text-sm text-loss">Error: ${(e as Error).message}</div>`;
      }
    }
    load();
  </script>
</Layout>
