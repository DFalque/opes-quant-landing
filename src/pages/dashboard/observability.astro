---
/**
 * /dashboard/observability — Aggregate telemetry view (v1.2.0, ADR-0009).
 *
 * Shows KPIs (cost, runtime, success rate), per-day cost + runtime charts,
 * and a top-10 expensive sessions table. All data comes from
 * `GET /api/agent/metrics/summary?range=...`.
 */
import Layout from '../../layouts/Layout.astro';
import ObservabilityDashboard from '../../components/ObservabilityDashboard.tsx';
---
<Layout title="Observabilidad" active="observability">
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900">Observabilidad del agente</h2>
    <p class="text-sm text-muted mt-1">
      Telemetría agregada de las sesiones de Hermes. Costes y tokens son
      <strong> estimados</strong> (heurística <code class="font-mono">v1</code>: chars/4 para output, ratio 8:1 input/output).
      Ver ADR-0009.
    </p>
  </div>

  <ObservabilityDashboard client:load />

  <p class="text-xs text-muted mt-6">
    Detalle por sesión en
    <a href="/dashboard/sessions" class="text-brand-600 hover:underline">Sesiones</a>.
    Pricing activo:
    <code class="font-mono" data-testid="pricing-version">—</code>.
  </p>
</Layout>
