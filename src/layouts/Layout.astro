---
/**
 * Base layout shared by all dashboard pages.
 * Renders the sidebar + main content area. Includes the global Tailwind CSS
 * and the ToastContainer (React island) for global notifications.
 */
import Sidebar from '../components/Sidebar.astro';
import ToastContainer from '../components/ToastContainer';
import { sitePath } from '../lib/site-path';
import '../styles/global.css';
import '../styles/private.css';

interface Props {
  title: string;
  active?: 'dashboard' | 'positions' | 'analyses' | 'sessions' | 'agent' | 'observability' | 'documentation' | 'skills' | 'tools' | 'backtest' | 'backtest-cripto';
}

const { title, active } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <title>{title} — opes-quant dashboard</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen font-sans dashboard-shell">
    <Sidebar active={active} />
    <main class="ml-0 lg:ml-64 p-4 sm:p-6 lg:p-8 max-w-7xl min-h-screen overflow-x-hidden dashboard-main">
      <slot />
    </main>
    <ToastContainer client:load />
  </body>
</html>
