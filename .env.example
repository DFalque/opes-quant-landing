# Sample env file. Copy to .env (gitignored) and fill in your values.

# Public API base URL (inlined into the client bundle by Astro/Vite).
# - Leave empty for local dev (uses Vite proxy at /api/*).
# - Set to the absolute URL of the FastAPI backend in production.
PUBLIC_API_BASE=

# Site URL for GitHub Pages (used for canonical URLs, sitemap, etc).
# - Custom domain:  https://opes.example.com
# - Project page:   https://DFalque.github.io/opes-quant-landing
# - Local dev:      leave empty
SITE_URL=

# Base path under the domain. '/' for root, '/opes-quant-landing' for project pages.
BASE_PATH=/
